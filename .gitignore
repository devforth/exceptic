# Raw SDK payload dumps from tools/envelope-dumper (contain local paths, hostnames, IPs).
# Sanitized copies go to testdata/envelopes/.
/envelopes/

# Logs
*.log
/logs/

# Local data (the database, volumes)
/data/

# Environment / secrets
.env
.env.*
!.env.example

# Go build output
/bin/
/dist/
/exceptic
*.exe
*.test
*.out
coverage.*

# Load tools for development only (tools/flood: flood runs against a local server)
/tools/flood/

# Node (tools)
node_modules/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
