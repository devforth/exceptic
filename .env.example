# Local development settings for `make run`. Copy to .env.local (gitignored) and adjust.
# In Docker, pass the same variables with -e or an env file.

# APP_NAME=Exceptic   # shown in the sidebar, page titles and emails, and to coding
#                                 # agents; agents register MCP under it in lowercase with
#                                 # dashes ("Acme Errors" -> acme-errors)
# PORT=8000
# DATA_DIR=./data                 # the database (DATA_DIR/leveldb); keep it on a volume in Docker

# Projects: id:name:public_key, comma-separated; the key is 16-64 letters or digits,
# e.g. `openssl rand -hex 16`. The DSN of a project is
# http://<public_key>@localhost:8000/<id>. A missing one is created with that
# name; after that its name, color and levels change on the Projects page and
# only the key follows PROJECTS at every start. More projects can be added on
# the Projects page.
# Optional: without it, add projects on the Projects page.
# PROJECTS=1:backend:<public key>,2:frontend:<public key>

# The superadmin of the web UI (password: at least 12 characters), created at the first
# start only; later changes here are ignored. Other users are added on the Users page.
# Until it is set, the UI is closed. A forgotten password:
# `exceptic reset-password [username]` with the server stopped.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# SESSION_LIFETIME=1d             # how long a UI login lasts (12h, 7d), not extended by use

# REST API token (at least 32 characters, e.g. `openssl rand -hex 32`). Without it the
# REST API is closed. Coding agents do not use it: they sign in to MCP (/mcp) with OAuth
# through their UI login, or with a personal token; the MCP page of the UI has the commands.
API_TOKEN=

# LOG_LEVEL=debug                 # also logs rejected envelopes and every request
# GOMEMLIMIT=200MiB               # memory the server aims to stay under (a soft limit)
# LOG_FORMAT=auto                 # pretty in a terminal, text (logfmt) otherwise; or json
# ALLOWED_IPS=203.0.113.0/24      # office/VPN networks allowed to open the UI, REST API and MCP (empty: any; not the Docker gateway)
# TRUSTED_PROXIES=127.0.0.1       # the reverse proxy whose X-Forwarded-For/-Proto are believed; in Docker the compose network gateway (docs/deployment.md)
#                                 # (client IP for ALLOWED_IPS and limits, https for cookies and DSNs)

# Ingest (the DSN endpoint SDKs send to).
# ALLOWED_ORIGINS=*               # browser origins allowed to send events (CORS), e.g.
#                                 # https://app.example.com,https://admin.example.com
# RATE_LIMIT_EVENTS_PER_MINUTE=10000  # events a project may send per minute; over it the SDK pauses events only; 0 = no limit
# RATE_LIMIT_LOGS_PER_MINUTE=10000    # logs (counted one by one, as received) per project per minute, at least 100; over it only logs pause; 0 = no limit

# Notifications about new and regressed issues. Where they go (email addresses,
# Telegram chats, Slack webhooks) is set up in the UI on the Notifications page.
# PUBLIC_URL=http://localhost:8000   # where the server is reachable: links in messages, DSNs and the
#                                    # MCP address (https://errors.example.com in production; over
#                                    # plain HTTP agent tokens could be read on the way)

# Encrypts Telegram tokens and Slack webhooks in the database (at least 32 characters,
# e.g. `openssl rand -hex 32`). Without it a key is generated into DATA_DIR/secret.key;
# on a server set it and keep it out of the data directory.
# SECRET_KEY=

# Delivery is stored in the database and retried (2s, 10s, 30s, ... then hourly).
# Durations take days or Go units: 30d, 12h, 90m.
# NOTIFY_RETRY_FOR=1d                # retry this long, then mark the message failed
# NOTIFY_KEEP_SENT=1d                # delete delivered messages after this
# NOTIFY_KEEP_FAILED=30d             # delete failed messages after this

# Mail server for email connections and their confirmation codes. Any SMTP provider
# works (Mailtrap sandbox for testing, Mailgun, SES, ...). Port 465 uses TLS from the
# start; other ports use STARTTLS when the server offers it, otherwise plain SMTP.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=errors@example.com

# Log levels stored; others are dropped when they arrive. A project can choose
# its own on the Projects page. "all", "none" or a list. Events of every level
# are stored.
# RECORD_LOG_LEVELS=all              # fatal, error, warn, info, debug, trace

# Size limit: at it the least useful data is deleted down to 80% (order: docs/configuration.md);
# events older than a month also lose their details as they age. 0 turns both off.
# MAX_DATABASE_SIZE=2GB
