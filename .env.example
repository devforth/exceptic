# Local development: `cp .env.example .env.local`, then `make dev`. Works as is.
# Every variable, with its default and limits: docs/configuration.md.
# On a server never keep these values: choose your own password and tokens (`openssl rand -hex 32`).

# The first admin, created while there is none (later changes here are ignored).
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin-password
# Sign in with Google: an OAuth client with the redirect URI <PUBLIC_URL>/auth/google/callback (needs PUBLIC_URL).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# id:name:public_key, comma-separated. DSN: http://<public_key>@localhost:8000/<id>
PROJECTS=1:backend:0123456789abcdef0123456789abcdef

# The REST API's token; without one the REST API is closed.
API_TOKEN=local-development-token-0123456789

# PUBLIC_URL=http://localhost:8000   # where the server is reachable: links in messages, DSNs, the MCP address
# ALLOWED_IPS=127.0.0.1,10.0.0.0/8   # addresses or networks, comma-separated, that may open the UI, API and MCP (ingest stays open)
# TRUSTED_PROXIES=127.0.0.1          # reverse proxies, comma-separated, whose X-Forwarded-For/-Proto are believed
# LOG_LEVEL=debug

# Email notifications (Mailtrap's sandbox for testing).
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=errors@example.com
